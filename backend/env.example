# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

# MongoDB Atlas connection string (from your cluster's "Connect" button)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/calorific?retryWrites=true&w=majority

# Secret used to sign JWTs - make this a long random string, same value for everyone on the team
JWT_SECRET=replace-this-with-a-long-random-string

# SendGrid API key (for verification + password reset emails)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Email address SendGrid is verified to send from
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Base URL of the frontend, used to build links in emails
CLIENT_URL=http://localhost:5173

# USDA FoodData Central API key (free signup at https://fdc.nal.usda.gov/api-key-signup.html)
FDC_API_KEY=replace-with-your-fdc-key

# Port the Express server runs on
PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# The Flutter mobile app sends no Origin header and is unaffected by this.
# Local dev example:  http://localhost:5173
# Production example: https://contactmanager24.xyz,https://www.contactmanager24.xyz
ALLOWED_ORIGINS=http://localhost:5173
