# Normalise all text files to LF in the repository.
# This is what prevents the mixed CRLF/LF corruption that broke Vite parsing:
# Windows checkouts still get CRLF locally, but what lands in git is always LF.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they will not execute.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must be LF even on Windows.
*.sh       text eol=lf
gradlew    text eol=lf

# Explicit source types (belt and braces on top of text=auto).
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.dart  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binary — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.zip   binary
*.jar   binary
*.keystore binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
