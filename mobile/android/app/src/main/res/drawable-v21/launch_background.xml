<?xml version="1.0" encoding="utf-8"?>
<!-- Shown briefly on app cold-start, before the Flutter engine draws the
     first frame. Uses the same brand background + leaf mark as the launcher
     icon so the transition from tapping the icon to the app opening feels
     seamless. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background"/>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground"/>
    </item>
</layer-list>
